/* ==========================================
   AnimeChat v2
   CSS 3A
========================================== */

*{
margin:0;
padding:0;
box-sizing:border-box;
}

:root{

--primary:#00a884;
--primary-dark:#00856a;

--bg:#0b141a;
--panel:#111b21;
--panel2:#202c33;

--border:#2a3942;

--text:#ffffff;
--sub:#8696a0;

--hover:#2a3942;

}

body{

font-family:"Poppins",sans-serif;

background:var(--bg);

color:var(--text);

overflow:hidden;

}

/* ==========================================
   SPLASH
========================================== */

#splashScreen{

position:fixed;

inset:0;

display:flex;

justify-content:center;

align-items:center;

background:var(--bg);

z-index:5000;

}

.splashContent{

text-align:center;

}

.logoCircle{

width:120px;
height:120px;

border-radius:50%;

background:var(--primary);

display:flex;

justify-content:center;

align-items:center;

font-size:56px;

margin:auto;

margin-bottom:25px;

}

.splashContent h1{

font-size:42px;

margin-bottom:10px;

}

.splashContent p{

color:var(--sub);

}

/* ==========================================
   LOGIN
========================================== */

#loginScreen{

position:fixed;

inset:0;

display:flex;

justify-content:center;

align-items:center;

background:var(--bg);

}

.loginCard{

width:420px;

padding:40px;

border-radius:20px;

background:var(--panel);

text-align:center;

box-shadow:0 10px 35px rgba(0,0,0,.35);

}

.loginLogo{

font-size:70px;

margin-bottom:20px;

}

.loginCard h2{

margin-bottom:10px;

}

.loginCard p{

color:var(--sub);

margin-bottom:30px;

}

#googleLoginButton{

width:100%;

height:54px;

border:none;

border-radius:12px;

background:var(--primary);

color:white;

font-size:16px;

font-weight:600;

cursor:pointer;

transition:.2s;

}

#googleLoginButton:hover{

background:var(--primary-dark);

}
/* ==========================================
   CSS 3B
   MAIN APP LAYOUT
========================================== */

.hidden{
display:none !important;
}

#app{

width:100vw;
height:100vh;

background:var(--bg);

}

.app{

display:flex;

width:100%;
height:100%;

}

/* ==========================================
   SIDEBAR
========================================== */

.sidebar{

width:370px;

background:var(--panel);

border-right:1px solid var(--border);

display:flex;

flex-direction:column;

}

.sidebarHeader{

height:72px;

padding:0 18px;

display:flex;

justify-content:space-between;

align-items:center;

background:var(--panel2);

}

.logo{

display:flex;

align-items:center;

gap:12px;

}

.logoIcon{

width:48px;
height:48px;

border-radius:50%;

background:var(--primary);

display:flex;

justify-content:center;

align-items:center;

font-size:24px;

}

.logo h2{

font-size:24px;

}

.headerButtons{

display:flex;

gap:10px;

}

.headerButtons button{

width:42px;
height:42px;

border:none;

border-radius:50%;

background:transparent;

color:white;

font-size:20px;

cursor:pointer;

transition:.2s;

}

.headerButtons button:hover{

background:var(--hover);

}

/* ==========================================
   SEARCH
========================================== */

.searchContainer{

padding:12px;

background:var(--panel);

}

.searchContainer input{

width:100%;

height:46px;

padding:0 16px;

border:none;

border-radius:12px;

background:var(--panel2);

color:white;

outline:none;

font-size:15px;

}

/* ==========================================
   CONTACTS
========================================== */

.contactList{

flex:1;

overflow-y:auto;

}

.contact{

display:flex;

align-items:center;

gap:14px;

padding:14px 16px;

cursor:pointer;

transition:.2s;

border-bottom:1px solid rgba(255,255,255,.04);

}

.contact:hover{

background:var(--hover);

}

.contact.active{

background:#2d3c46;

}

.contactAvatar{

width:54px;
height:54px;

border-radius:50%;

background:var(--primary);

display:flex;

justify-content:center;

align-items:center;

font-size:26px;

color:white;

}

.contactInfo{

flex:1;

}

.contactInfo h3{

font-size:16px;

font-weight:600;

}

.contactInfo p{

font-size:13px;

color:var(--sub);

margin-top:2px;

}

.contactTime{

font-size:12px;

color:var(--sub);

}
/* ==========================================
   CSS 3C
   CHAT AREA
========================================== */

.chatContainer{

flex:1;

display:flex;

flex-direction:column;

background:var(--bg);

}

/* ==========================================
   CHAT HEADER
========================================== */

.chatHeader{

height:72px;

padding:0 18px;

background:var(--panel2);

display:flex;

align-items:center;

gap:14px;

border-bottom:1px solid var(--border);

}

#backButton{

display:none;

border:none;

background:none;

color:white;

font-size:22px;

cursor:pointer;

}

.chatAvatar{

width:50px;

height:50px;

border-radius:50%;

background:var(--primary);

display:flex;

justify-content:center;

align-items:center;

font-size:24px;

color:white;

}

.chatDetails{

flex:1;

}

.chatDetails h2{

font-size:18px;

font-weight:600;

}

.chatDetails p{

font-size:13px;

color:var(--sub);

margin-top:2px;

}

.chatActions{

display:flex;

gap:8px;

}

.chatActions button{

width:42px;

height:42px;

border:none;

border-radius:50%;

background:transparent;

color:white;

font-size:20px;

cursor:pointer;

transition:.2s;

}

.chatActions button:hover{

background:var(--hover);

}

/* ==========================================
   MESSAGE AREA
========================================== */

.messages{

flex:1;

overflow-y:auto;

padding:20px;

display:flex;

flex-direction:column;

gap:12px;

background:#0b141a;

}

.message{

max-width:72%;

padding:10px 14px;

border-radius:14px;

word-break:break-word;

animation:fadeIn .18s ease;

}

.message.user{

align-self:flex-end;

background:var(--primary);

color:white;

border-bottom-right-radius:4px;

}

.message.bot{

align-self:flex-start;

background:var(--panel2);

color:white;

border-bottom-left-radius:4px;

}

.messageTime{

font-size:11px;

margin-top:5px;

opacity:.7;

text-align:right;

}

/* ==========================================
   INPUT BAR
========================================== */

.chatInput{

height:74px;

padding:12px;

display:flex;

align-items:center;

gap:10px;

background:var(--panel2);

border-top:1px solid var(--border);

}

.chatInput button{

width:46px;

height:46px;

border:none;

border-radius:50%;

background:transparent;

color:white;

font-size:20px;

cursor:pointer;

transition:.2s;

}

.chatInput button:hover{

background:var(--hover);

}

.chatInput input{

flex:1;

height:48px;

padding:0 18px;

border:none;

border-radius:24px;

background:var(--panel);

color:white;

font-size:15px;

outline:none;

}

/* ==========================================
   ANIMATION
========================================== */

@keyframes fadeIn{

from{

opacity:0;

transform:translateY(10px);

}

to{

opacity:1;

transform:translateY(0);

}

}
/* ==========================================
   CSS 3D
   PAGES
========================================== */

.page{

position:fixed;

top:0;
left:0;

width:100%;
height:100%;

background:var(--bg);

display:flex;

flex-direction:column;

z-index:2000;

}

.page.hidden{

display:none;

}

/* ==========================================
   PAGE HEADER
========================================== */

.pageHeader{

height:72px;

display:flex;

align-items:center;

gap:15px;

padding:0 18px;

background:var(--panel2);

border-bottom:1px solid var(--border);

}

.pageHeader button{

width:42px;
height:42px;

border:none;

border-radius:50%;

background:transparent;

color:white;

font-size:22px;

cursor:pointer;

}

.pageHeader button:hover{

background:var(--hover);

}

.pageHeader h2{

font-size:22px;

font-weight:600;

}

/* ==========================================
   PAGE CONTENT
========================================== */

.pageContent{

flex:1;

overflow-y:auto;

padding:20px;

}

/* ==========================================
   FRIENDS
========================================== */

#friendSearch{

width:100%;

height:50px;

padding:0 18px;

border:none;

border-radius:12px;

background:var(--panel2);

color:white;

outline:none;

margin-bottom:20px;

font-size:15px;

}

.friendCard{

display:flex;

align-items:center;

gap:15px;

padding:14px;

border-radius:14px;

background:var(--panel);

margin-bottom:12px;

cursor:pointer;

transition:.2s;

}

.friendCard:hover{

background:var(--hover);

}

.friendAvatar{

width:56px;

height:56px;

border-radius:50%;

background:var(--primary);

display:flex;

justify-content:center;

align-items:center;

font-size:24px;

}

/* ==========================================
   AI
========================================== */

.aiCard{

display:flex;

align-items:center;

gap:15px;

padding:16px;

background:var(--panel);

border-radius:14px;

margin-bottom:14px;

cursor:pointer;

transition:.2s;

}

.aiCard:hover{

background:var(--hover);

}

.aiAvatar{

width:60px;

height:60px;

border-radius:50%;

background:var(--primary);

display:flex;

justify-content:center;

align-items:center;

font-size:28px;

}

.aiInfo{

flex:1;

}

.aiInfo h3{

font-size:17px;

margin-bottom:4px;

}

.aiInfo p{

font-size:13px;

color:var(--sub);

}

/* ==========================================
   PROFILE
========================================== */

.profileCard{

display:flex;

flex-direction:column;

align-items:center;

margin-bottom:35px;

}

#profileAvatar{

width:120px;

height:120px;

border-radius:50%;

background:var(--primary);

display:flex;

justify-content:center;

align-items:center;

font-size:56px;

margin-bottom:18px;

}

#profileName{

font-size:24px;

margin-bottom:6px;

}

#profileUsername{

color:var(--sub);

margin-bottom:24px;

}

#editProfileButton,
#logoutButton{

width:100%;

height:52px;

border:none;

border-radius:12px;

background:var(--primary);

color:white;

font-size:16px;

cursor:pointer;

margin-bottom:14px;

transition:.2s;

}

#logoutButton{

background:#d84a4a;

}

#editProfileButton:hover{

background:var(--primary-dark);

}

#logoutButton:hover{

background:#b63d3d;

}

/* ==========================================
   SETTINGS
========================================== */

#settingsPage button{

width:100%;

height:54px;

margin-bottom:14px;

border:none;

border-radius:12px;

background:var(--panel);

color:white;

font-size:16px;

text-align:left;

padding:0 18px;

cursor:pointer;

transition:.2s;

}

#settingsPage button:hover{

background:var(--hover);

}
/* ==========================================
   CSS 3E
   CALLS • POPUPS • RESPONSIVE
========================================== */

/* ========= CALL SCREEN ========= */

.callScreen{

flex:1;

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

text-align:center;

padding:30px;

}

#incomingAvatar,
#callAvatar{

width:160px;
height:160px;

border-radius:50%;

background:var(--primary);

display:flex;

justify-content:center;

align-items:center;

font-size:72px;

margin-bottom:30px;

}

#incomingName,
#callName{

font-size:32px;

margin-bottom:10px;

}

#callStatus{

color:var(--sub);

font-size:16px;

margin-bottom:40px;

}

.callButtons{

display:flex;

gap:20px;

flex-wrap:wrap;

justify-content:center;

}

.callButtons button{

width:70px;
height:70px;

border:none;

border-radius:50%;

font-size:28px;

cursor:pointer;

transition:.25s;

color:white;

}

#acceptCall{

background:#22c55e;

}

#rejectCall,
#endCallButton{

background:#ef4444;

}

#muteButton,
#speakerButton,
#cameraToggleButton{

background:var(--panel2);

}

.callButtons button:hover{

transform:scale(1.08);

}

/* ========= POPUPS ========= */

.popup{

position:fixed;

bottom:90px;

right:20px;

min-width:220px;

padding:15px;

background:var(--panel);

border:1px solid var(--border);

border-radius:14px;

box-shadow:0 12px 30px rgba(0,0,0,.35);

z-index:3000;

}

.popup.hidden{

display:none;

}

/* ========= NOTIFICATIONS ========= */

#notificationContainer{

position:fixed;

top:20px;

right:20px;

display:flex;

flex-direction:column;

gap:12px;

z-index:4000;

}

.notification{

padding:14px 18px;

border-radius:12px;

background:var(--panel2);

color:white;

box-shadow:0 8px 24px rgba(0,0,0,.35);

animation:slideIn .25s ease;

}

@keyframes slideIn{

from{

opacity:0;

transform:translateX(30px);

}

to{

opacity:1;

transform:translateX(0);

}

}

/* ========= BOTTOM NAV ========= */

.bottomNavigation{

display:none;

height:68px;

background:var(--panel2);

border-top:1px solid var(--border);

justify-content:space-around;

align-items:center;

}

.bottomNavigation button{

flex:1;

height:100%;

border:none;

background:none;

color:var(--sub);

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

gap:3px;

font-size:22px;

cursor:pointer;

transition:.2s;

}

.bottomNavigation button:hover{

background:var(--hover);

}

.bottomNavigation span{

font-size:11px;

}

/* ========= MOBILE ========= */

@media(max-width:900px){

.sidebar{

width:100%;

}

.chatContainer{

display:none;

}

.bottomNavigation{

display:flex;

}

#backButton{

display:block;

}

}

/* ========= DESKTOP ========= */

@media(min-width:901px){

.bottomNavigation{

display:none;

}

}
