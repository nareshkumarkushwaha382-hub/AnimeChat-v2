"use strict";

/* ==========================================
   AnimeChat v2
   JavaScript 1A
========================================== */

document.addEventListener("DOMContentLoaded", () => {

console.log("AnimeChat v2 Started");

/* ========= DOM ========= */

const splashScreen=document.getElementById("splashScreen");

const loginScreen=document.getElementById("loginScreen");

const app=document.getElementById("app");

const googleLoginButton=document.getElementById("googleLoginButton");
const messageInput = document.getElementById("messageInput");
const sendButton = document.getElementById("sendButton");

/* ========= START ========= */

app.classList.add("hidden");

loginScreen.classList.add("hidden");

setTimeout(()=>{

splashScreen.classList.add("hidden");

loginScreen.classList.remove("hidden");

},2000);

/* ========= LOGIN ========= */

googleLoginButton.addEventListener("click",()=>{

loginScreen.classList.add("hidden");

app.classList.remove("hidden");

console.log("User entered AnimeChat");

});

});
/* ========= CONTACT DATA ========= */

const contactList = document.getElementById("contactList");
const chatName = document.getElementById("chatName");
const chatAvatar = document.getElementById("chatAvatar");
const chatStatus = document.getElementById("chatStatus");
const messages = document.getElementById("messages");

const contacts=[

{

name:"Rem",

avatar:"💙",

status:"Online",

time:"09:42",

messages:[

{sender:"bot",text:"Hello 👋",time:"09:40"},

{sender:"user",text:"Hi Rem!",time:"09:41"}

]

},

{

name:"Gojo",

avatar:"👑",

status:"Online",

time:"08:30",

messages:[

{sender:"bot",text:"Yo!",time:"08:20"}

]

},

{

name:"Subaru",

avatar:"⚔️",

status:"Typing...",

time:"Now",

messages:[]

},

{

name:"Friend",

avatar:"👤",

status:"Offline",

time:"Yesterday",

messages:[]

}

];

let currentChat=contacts[0];

/* ========= RENDER CONTACTS ========= */

function renderContacts(){

contactList.innerHTML="";

contacts.forEach(contact=>{

const card=document.createElement("div");

card.className="contact";

card.innerHTML=`

<div class="contactAvatar">

${contact.avatar}

</div>

<div class="contactInfo">

<h3>${contact.name}</h3>

<p>${contact.lastMessage || contact.status}</p>

</div>

<div class="contactTime">

${contact.time}

</div>

`;

card.addEventListener("click",()=>{

openChat(contact);

});

contactList.appendChild(card);

});

}
function renderMessages(){

messages.innerHTML="";

currentChat.messages.forEach(message=>{

const bubble=document.createElement("div");

bubble.className="message "+message.sender;

bubble.innerHTML=`

<div>${message.text}</div>

<div class="messageTime">

${message.time}

</div>

`;

messages.appendChild(bubble);

});

messages.scrollTop=messages.scrollHeight;

}

function openChat(contact){

currentChat=contact;

chatName.textContent=contact.name;

chatAvatar.textContent=contact.avatar;

chatStatus.textContent=contact.status;

renderMessages();
const messageInput = document.getElementById("messageInput");
const sendButton = document.getElementById("sendButton");

}
function getTime(){

const now=new Date();

return now.toLocaleTimeString([],{

hour:"2-digit",

minute:"2-digit"

});

}
function sendMessage(){

const text=messageInput.value.trim();

if(text==="") return;

currentChat.messages.push({

sender:"user",

text:text,

time:getTime()

});

messageInput.value="";

renderMessages();

setTimeout(()=>{

currentChat.messages.push({

sender:"bot",

text:"This is a demo reply.",

time:getTime()

});

renderMessages();

},1000);

}
sendButton.addEventListener("click",sendMessage);

messageInput.addEventListener("keydown",e=>{

if(e.key==="Enter"){

sendMessage();

}

});
